<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.williamtobin.assignment-reminder.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/william.tobin/assignment-reminder/weekly.js</string>
  </array>
  <!-- Weekday: 0 or 7 = Sunday, 6 = Saturday -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>6</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/william.tobin/assignment-reminder/reminder.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/william.tobin/assignment-reminder/reminder.log</string>
</dict>
</plist>
